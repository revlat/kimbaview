# Zeilenenden festlegen, damit Skripte auf Linux/macOS auch nach einem Commit unter
# Windows funktionieren (CRLF würde "sh" und die .desktop-Datei stören).
* text=auto
*.sh       text eol=lf
*.desktop  text eol=lf
*.xml      text eol=lf
*.plist    text eol=lf
*.yml      text eol=lf
*.ps1      text eol=crlf
*.iss      text eol=crlf
*.png      binary
*.ico      binary
*.icns     binary
